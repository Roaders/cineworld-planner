{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "outDir": "./out-tsc/spec",
        "types": [
          "node",
          "vitest/globals"
        ]
    },
    "files": [
        "src/polyfills.ts"
    ],
    "include": [
        "src/**/*.spec.ts",
        "src/**/*.d.ts"
    ],
    "angularCompilerOptions": {
        "strictTemplates": false
    }
}
