{
  "name": "cineworld-planner",
  "description": "An Application to help plan multi-film visits to cineworld",
  "version": "1.6.4",
  "scripts": {
    "clean": "rimraf dist build",
    "start-app": "ng serve --open",
    "start-app-local": "ng serve --open",
    "start-app-ring": "ng serve --open --configuration=ring",
    "start-app-production": "ng serve --open --configuration=production",
    "watch-build-node": "tsc -p src/node/tsconfig.json --watch",
    "start-ts-node": "ts-node --project src/node/tsconfig.json src/node/server/index.ts",
    "start-node": "node dist/node/server",
    "watch-node": "nodemon",
    "predebug-node": "npm run clean && npm run build-node",
    "preverify-release": "npm run clean",
    "build-app": "ng build",
    "build-node": "tsc -p src/node/tsconfig.json",
    "debug-node": "node --inspect dist/node/server",
    "build": "ng build",
    "build-prod": "ng build --configuration=production",
    "watch-test": "ng test",
    "verify-release": "concurrently npm:lint npm:build-node npm:test npm:build-prod",
    "release": "npm version patch && git push origin --follow-tags",
    "test": "ng test --watch=false",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/language-service": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "angular-eslint": "^22.5.0",
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "font-awesome": "^4.7.0",
    "geolib": "^3.3.14",
    "happy-dom": "^20.14.5",
    "istanbul-lib-instrument": "^6.0.3",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roaders/cineworld-planner.git"
  },
  "engines": {
    "node": "26.x"
  },
  "bundleDependencies": [
    "express",
    "cors",
    "rxjs",
    "axios"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Roaders/cineworld-planner/issues"
  },
  "homepage": "https://github.com/Roaders/cineworld-planner#readme"
}
