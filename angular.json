{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "cli": {
        "analytics": "b29afc66-a6a4-449d-a476-4b6ed8214783"
    },
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "cineworld-planner": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": {
                          "base": "dist/cineworld-planner"
                        },
                        "index": "src/index.html",
                        "polyfills": [
                          "src/polyfills.ts"
                        ],
                        "tsConfig": "tsconfig.app.json",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets"
                        ],
                        "styles": [
                            "src/app/styles/styles.scss"
                        ],
                        "scripts": [],
                        "extractLicenses": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true,
                        "browser": "src/main.ts"
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "src/app/environments/environment.ts",
                                    "with": "src/app/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb",
                                    "maximumError": "10kb"
                                }
                            ]
                        },
                        "ring": {
                            "fileReplacements": [
                                {
                                    "replace": "src/app/environments/environment.ts",
                                    "with": "src/app/environments/environment.ring.ts"
                                }
                            ]
                        },
                        "testing": {
                          "aot": false,
                          "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                          ]
                        }
                    },
                    "defaultConfiguration": ""
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                      "buildTarget": "cineworld-planner:build"
                    },
                    "configurations": {
                        "production": {
                          "buildTarget": "cineworld-planner:build:production"
                        },
                        "ring": {
                          "buildTarget": "cineworld-planner:build:ring"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {
                      "buildTarget": "cineworld-planner:build"
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                      "tsConfig": "tsconfig.spec.json",
                        "reporters": [
                          "default"
                        ],
                        "coverageReporters": [
                          "html",
                          "lcovonly",
                          "text-summary"
                        ],
                        "buildTarget": ":build:testing",
                        "runner": "vitest"
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "src/**/*.ts",
                            "src/**/*.html"
                        ]
                    }
                }
            }
        }
    },
    "schematics": {
      "@schematics/angular:component": {
        "type": "component"
      },
      "@schematics/angular:directive": {
        "type": "directive"
      },
      "@schematics/angular:service": {
        "type": "service"
      },
      "@schematics/angular:guard": {
        "typeSeparator": "."
      },
      "@schematics/angular:interceptor": {
        "typeSeparator": "."
      },
      "@schematics/angular:module": {
        "typeSeparator": "."
      },
      "@schematics/angular:pipe": {
        "typeSeparator": "."
      },
      "@schematics/angular:resolver": {
        "typeSeparator": "."
      }
    }
}
